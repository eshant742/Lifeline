<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/dark_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="User"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/ivConnectionStatus"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@android:drawable/presence_online"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvConnectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 peers connected"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="16dp"/>

        <ImageView
            android:id="@+id/btnRefreshPeers"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh Peers"/>
    </LinearLayout>

    <!-- Location Display -->
    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="📍 Waiting for GPS..."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@color/dark_surface_variant"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Status Toggle -->
    <LinearLayout
        android:id="@+id/statusToggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrapped"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🔴 TRAPPED"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/emergency_red"
            app:cornerRadius="8dp"
            android:layout_marginEnd="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSafe"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🟢 SAFE"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/dark_surface"
            app:cornerRadius="8dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Send Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSos"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="📨 SEND MESSAGE"
        android:textSize="24sp"
        android:textStyle="bold"
        app:backgroundTint="@color/emergency_red"
        app:cornerRadius="16dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/statusToggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Message Input Row -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnSos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Custom message (optional)"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/bg_rounded_white"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoice"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="🎤 Voice"
            android:textSize="12sp"
            app:backgroundTint="@color/dark_surface"
            app:cornerRadius="8dp"
            android:layout_marginEnd="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMap"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="🗺️ Map"
            android:textSize="12sp"
            app:backgroundTint="@color/dark_surface"
            app:cornerRadius="8dp"/>
    </LinearLayout>

    <!-- Recording Status -->
    <TextView
        android:id="@+id/tvRecordingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴 Recording..."
        android:textColor="@color/emergency_red"
        android:textSize="12sp"
        android:visibility="gone"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/inputRow"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Message Count -->
    <TextView
        android:id="@+id/tvMessageCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0 signals received"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@color/dark_surface"
        app:layout_constraintTop_toBottomOf="@id/tvRecordingStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMessageCount"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
